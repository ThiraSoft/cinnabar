# Copier en .env (ignoré par git) avant `docker compose --profile app up`.
# Sans ce fichier, Compose passe une chaîne vide pour chaque variable
# absente, ce qui donne une base d'URL vide plutôt qu'une erreur claire au
# démarrage.

# Endpoint compatible OpenAI (vLLM, Ollama, OpenAI...) utilisé par
# l'extraction du graphe et le rerank. Tant que graph.enabled et
# rerank.enabled restent à false, une valeur bidon suffit.
LLM_API_URL=http://host.docker.internal:8000/v1

# Clé d'API de cet endpoint. Une valeur bidon suffit tant qu'il ne sert pas.
LLM_API_KEY=dummy
